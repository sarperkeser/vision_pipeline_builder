import torch
import torch.nn as nn
import torch.optim as optim
from torchvision import datasets, transforms
from torch.utils.data import DataLoader

def main():
# Dynamic Input Size and Augmentation Configuration
    input_width = {{ dataset.input_size[0] }}
    input_height = {{ dataset.input_size[1] }}
    num_classes = {{ dataset.num_classes }}

    transform = transforms.Compose([
        transforms.Resize((input_width, input_height)),
        {% if dataset.transform.h_flip %}transforms.RandomHorizontalFlip(p=0.5),{% endif %}
        {% if dataset.transform.v_flip %}transforms.RandomVerticalFlip(p=0.5),{% endif %}
        {% if dataset.transform.rotation > 0 %}transforms.RandomRotation({{ dataset.transform.rotation }}),{% endif %}
        {% if dataset.transform.color_jitter %}
        transforms.ColorJitter(brightness={{ dataset.transform.jitter_brightness }}, contrast={{ dataset.transform.jitter_contrast }}, saturation={{ dataset.transform.jitter_saturation }}),
        {% endif %}
        {% if dataset.transform.gaussian_blur %}
        transforms.GaussianBlur(kernel_size={{ dataset.transform.blur_kernel }}),
        {% endif %}
        transforms.ToTensor(),
    ])

    dataset = datasets.ImageFolder(root=r"{{ dataset.folder_path }}", transform=transform)
    dataloader = DataLoader(dataset, batch_size={{ dataset.batch_size }}, shuffle={{ dataset.shuffle }})
    
    print(f"Veri Seti Yüklendi | Görsel Boyutu: {input_width}x{input_height} | Sınıf Sayısı: {num_classes} | Toplam Görsel: {len(dataset)}")

    # Dinamik CNN Model Mimarisi
    class CustomVisionModel(nn.Module):
        def __init__(self):
            super().__init__()
            self.features = nn.Sequential(
                {% for layer in layers %}
                {% if layer.layer_type == "Conv2d" %}
                nn.Conv2d(in_channels={{ layer.in_channels }}, out_channels={{ layer.out_channels }}, kernel_size={{ layer.kernel_size }}),
                {% elif layer.layer_type == "Linear" %}
                nn.Linear(in_features={{ layer.in_channels }}, out_features={{ layer.out_channels }}),
                {% elif layer.layer_type == "MaxPool2d" %}
                nn.MaxPool2d(kernel_size=2, stride=2),
                {% endif %}
                
                {% if layer.activation != "None" %}
                nn.{{ layer.activation }}(),
                {% endif %}
                
                {% endfor %}
            )

        def forward(self, x):
            return self.features(x)

    model = CustomVisionModel()
    print("\nModel Mimarisi:")
    print(model)
    
    # Eğitim Konfigürasyonu
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.{{ train.optimizer }}(model.parameters(), lr={{ train.learning_rate }})
    epochs = {{ train.epochs }}

    print(f"\n{epochs} Epoch boyunca {train.optimizer} (LR: {{ train.learning_rate }}) ile eğitim başlatılmaya hazır.")

if __name__ == "__main__":
    main()